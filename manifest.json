{
  "manifest_version": 3,
  "name": "DecodeThis VIN Lookup",
  "version": "1.0.0",
  "minimum_chrome_version": "123",
  "description": "Select a VIN on a web page, right-click, and decode it on DecodeThis in a new tab.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
